NODE_ENV=production
PORT=3000
DATA_DIR=/data
RETENTION_DAYS=180
CAREERS_ENCRYPTION_KEY=base64-encode-32-random-bytes
CAREERS_RATE_LIMIT_SECRET=replace-with-32-or-more-random-characters
CAREERS_ADMIN_USER=sici-review
CAREERS_ADMIN_PASSWORD=replace-with-at-least-20-random-characters

# Optional email notifications (applicants are stored even when these are absent)
RESEND_API_KEY=
NOTIFICATION_TO=hello@sici.uk
NOTIFICATION_FROM=SICI Careers <careers@sici.uk>
